# SQLite runs without Docker. Copy this file to .env to override settings.
VERDICT_DATABASE_URL=sqlite:///data/verdict.db
VERDICT_POLL_INTERVAL_SECONDS=2
VERDICT_REQUEST_TIMEOUT_SECONDS=10
VERDICT_FRESHNESS_SECONDS=30
VERDICT_MAX_FUTURE_SKEW_SECONDS=5
# Continuous ingestion only; --once still polls REST.
VERDICT_COINBASE_STREAM_ENABLED=false
VERDICT_COINBASE_WEBSOCKET_URL=wss://ws-feed.exchange.coinbase.com
VERDICT_COINBASE_STREAM_TIMEOUT_SECONDS=10
VERDICT_COINBASE_RECOVERY_PAGE_SIZE=1000
VERDICT_COINBASE_RECOVERY_MAX_PAGES=20
VERDICT_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
VERDICT_ETHEREUM_BLOCK_TAG=latest
VERDICT_ONCHAIN_POLL_INTERVAL_SECONDS=15
VERDICT_USDC_CONVERSION_MAX_AGE_SECONDS=86400
VERDICT_PYTH_HERMES_URL=https://hermes.pyth.network
# Required by authenticated Hermes services. Never commit your real API key.
VERDICT_PYTH_API_KEY=
VERDICT_LOG_LEVEL=INFO
